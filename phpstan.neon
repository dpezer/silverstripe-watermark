parameters:
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        - '#Static property [a-zA-Z0-9\\_]+::\$db is never read, only written\.#'
        - '#Static property [a-zA-Z0-9\\_]+::\$has_one is never read, only written\.#'
        - '#Static property [a-zA-Z0-9\\_]+::\$owns is never read, only written\.#'
    parallel:
        maximumNumberOfProcesses: 4
    level: 5
    paths:
        - src
    scanDirectories:
        - vendor