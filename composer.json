{
    "name": "gurucomkz/watermark",
    "type": "silverstripe-vendormodule",
    "description": "Watermarking the images upon output in SilverStripe",
    "keywords": [
        "silverstripe",
        "watermarking",
        "watermark",
        "image"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Sergey Shevchenko",
            "homepage": "https://github.com/gurucomkz"
        }
    ],
    "require": {
        "silverstripe/vendor-plugin": "^2.0",
        "silverstripe/asset-admin": "^2",
        "silverstripe/siteconfig": "^5",
        "silverstripe/framework": "^5"
    },
    "extra": {
        "expose": [
        ]
    },
    "autoload": {
        "psr-4": {
            "Gurucomkz\\Watermark\\": "src/Gurucomkz/Watermark",
            "Gurucomkz\\Watermark\\Tests\\": "tests"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "scripts": {
        "stan": [
            "Composer\\Config::disableProcessTimeout",
            "./vendor/bin/phpstan analyze --memory-limit=1G"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "XDEBUG_MODE=coverage ./vendor/bin/phpunit"
        ]
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.11",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^9.6"
    }
}
